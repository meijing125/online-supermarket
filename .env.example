# 环境变量示例 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# Flask Session 加密密钥。留空则每次启动使用随机值，会导致重启后用户被登出。
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite 数据库文件路径。默认是项目根目录下的 supermarket.db，
# 部署到云平台时可指向挂载的持久化磁盘。
DB_PATH=

# 监听端口。云平台会自动注入，本地开发无需设置。
PORT=

# 设为 1 开启调试模式（仅本地开发使用，生产环境务必不要开启）
FLASK_DEBUG=
